# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Backend API URL (defaults to http://localhost:5000 in dev or https://gash-be.onrender.com in prod)
VITE_API_URL=http://localhost:5000

# EmailJS Configuration (optional order notifications)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_ORDER_TEMPLATE_ID=your_emailjs_order_template_id
VITE_ENABLE_ORDER_EMAIL_NOTIFICATIONS=false

# Demo/Mock Mode (set to 'true' to use in-browser mock adapter)
# VITE_APP_USE_MOCK=true

# LiveKit Server URL for Livestreaming WebRTC
VITE_LIVEKIT_SERVER_URL=wss://your-livekit-server.livekit.cloud
