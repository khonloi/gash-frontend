# ==============================================================================
# GASH FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Backend API URL (for direct client-side requests or fallbacks)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Internal Backend URL for Server-Side calls / Next.js rewrites (/api/v1/:path* -> backend)
INTERNAL_API_URL=http://localhost:5000/api/v1

# Offline Demo Mode:
# Set to 'true' for standalone offline preview/mock data.
# Set to 'false' in production or when connected to gash-backend-v2.
NEXT_PUBLIC_DEMO_MODE=false
